# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Runtime data — never commit transferred files, the metadata store, or the
# admin key it holds. These are other people's files.
# ---------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
metadata.json
metadata.json.tmp
*.log
logs/

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision
*.keystore
*.jks
.tauri/
~/.tauri/
secrets.json

# ---------------------------------------------------------------------------
# Desktop app build output — the compiled server binary and the staged copy of
# public/ are generated by desktop/scripts/build-server.sh. Never committed.
# ---------------------------------------------------------------------------
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/resources/
desktop/src-tauri/gen/
# `tauri icon` also emits Microsoft Store / UWP tiles. tauri.conf.json declares
# only five icons and this project ships NSIS/MSI, so the tiles are dead weight.
desktop/src-tauri/icons/Square*Logo.png
desktop/src-tauri/icons/StoreLogo.png
desktop/src-tauri/icons/android/
desktop/src-tauri/icons/ios/

# Marketing collateral lives with the brand, not the source. YouTube thumbnails
# are served from img.youtube.com; social cards are uploaded in repo settings.
assets/youtube-thumbnail.*
*.app
*.dmg
*.msi
*.exe
*.AppImage
*.deb
*.rpm

# ---------------------------------------------------------------------------
# Editor, OS, and local assistant tooling — not part of the product
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
.claude/
.projectmem/
CLAUDE.md
AGENTS.md
.cursor/
.aider*
