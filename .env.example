# MeghXL configuration — all values are optional, sensible defaults are used.
# Copy to ".env" only if you use a tool that loads it; the app reads process.env
# directly, so `PORT=8080 npm start` works without any file.

# Port to listen on
PORT=3000

# Max upload size, in megabytes. Unset or 0 = unlimited ("any size", the default).
# Set a positive number to cap it, e.g. MAX_UPLOAD_MB=2048 for a 2 GB limit.
# MAX_UPLOAD_MB=0

# Where uploaded files are stored on disk
UPLOAD_DIR=./uploads

# Path to the JSON metadata store
DATA_FILE=./metadata.json

# Optional: designate which PC(s) get the admin console, by LAN IP. EVERY
# browser on that PC becomes admin. The PC running the server is already admin
# automatically; use this to make a *different* PC the admin (e.g. when the
# server runs on a NAS). Give that PC a static IP / DHCP reservation so it's
# stable. Comma-separate for several.
# ADMIN_IP=192.168.x.x

# Optional: allow the host console over the internet with a key (host PC needs
# none). Then open /admin?key=YOURKEY from anywhere.
# ADMIN_KEY=

# --- Remote access (advanced, optional — not needed for LAN use) ---
# MeghXL is LAN-only by design and never exposes itself to the internet.
# If you need outside access, put it behind YOUR OWN authenticated layer — a VPN
# (WireGuard / Tailscale) or an authenticated reverse proxy — then set this to
# that address so links + QR codes point at it. Add auth at that layer.
# PUBLIC_BASE_URL=https://meghxl.your-company.com
